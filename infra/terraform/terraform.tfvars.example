# Your settings for the stack.
#
#   cp terraform.tfvars.example terraform.tfvars      (terraform.tfvars is gitignored)
#
# Only project_id is required: with just that, `make deploy` builds a working
# app with one model (Qwen3-VL 8B on an L4) in us-central1. Uncomment and
# change what you need. Full descriptions are in variables.tf; the
# step-by-step guide is docs/04-deploy-the-full-stack-on-google-cloud.md.
#
# Never put a key file or password for your Google account here. Terraform
# uses the login from `make gcp-login`.

# =============================================================== basics =====

project_id = "my-llm-chat-123" # your project ID (console: the project picker)

# A region with Cloud Run GPUs: us-central1, us-east4, europe-west1,
# europe-west4, asia-southeast1 (L4). The RTX PRO 6000: us-central1,
# europe-west4, asia-southeast1, asia-south2.
# region = "us-central1"

# app         = "llmchat"   # start of every resource name
# environment = "dev"       # "prod" turns on deletion protection for the database and uploads

# =============================================================== models =====
# One Cloud Run GPU service per entry. The key is the model's id in the app;
# `preset` is a name from ml/models/catalog.json (`make model-presets`).
# Each model sleeps (0 instances, $0) until someone chats, then wakes in 1-3
# minutes. min_instances = 1 keeps it awake: ~$1,000+/month for an L4.
# A new project gets 3 L4 GPUs per region automatically, so up to 3 models
# can be awake at once.

# models = {
#   "qwen3-vl-8b" = { preset = "qwen3-vl-8b", default = true }
#   "qwen3-8b"    = { preset = "qwen3-8b" }
#
#   # Gated (Llama, Gemma): accept the licence on huggingface.co and put
#   # HF_TOKEN=hf_... in .env before `make deploy`.
#   # "llama-3.1-8b" = { preset = "llama-3.1-8b" }
#
#   # Any other model vLLM supports: give every field yourself.
#   # "my-model" = {
#   #   hf_model_id   = "Qwen/Qwen3-4B-Instruct-2507"
#   #   gpu_type      = "nvidia-l4"
#   #   cpu           = 4
#   #   memory        = "16Gi"
#   #   max_model_len = 32768
#   #   vllm_args     = ["--enable-prefix-caching"]
#   # }
# }

# ================================================================ users =====

# app_name           = "Private LLM Chat"
# admin_emails       = ["you@example.com"] # admins once they verify their email
# signup_enabled     = true                # false: only admins add users (/admin/)
# email_verification = "mandatory"         # mandatory | optional | none

# "Sign in with Google" (docs/authentication.md). Add the app_url (terraform
# output app_url) to the OAuth client's Authorized JavaScript origins.
# google_client_id = "1234567890-abc.apps.googleusercontent.com"

# ================================================================ email =====
# Google Cloud has no email-sending service. "console" (default) writes each
# email to the api's logs (Cloud Logging): fine to try the app, where you read
# your own sign-up code there. For real users, any SMTP provider:

# email_provider = "smtp"
# from_email     = "Private LLM Chat <no-reply@example.com>"
# smtp_host      = "smtp.sendgrid.net"   # or smtp-relay.brevo.com, smtp.mailgun.org, smtp.gmail.com
# smtp_port      = 587
# smtp_username  = "apikey"
# smtp_password  = "..."                 # or: export TF_VAR_smtp_password=... (keeps it out of this file)

# ============================================================== features =====

# enable_web_search     = true   # SearXNG next to the api: the chat's Search button
# enable_speech_to_text = true   # Whisper next to the api: the microphone button

# ============================================================== database =====

# db_tier    = "db-f1-micro"   # ~$9/month; "db-g1-small" ~$27; "db-custom-1-3840" ~$50
# db_disk_gb = 10

# ================================================================= scale =====

# api_min_instances = 0   # 1 = no cold start for the first visitor (~$10-20/month more)
# web_min_instances = 0

# ================================================================ GitHub =====
# Deploy from GitHub Actions without keys (.github/workflows/deploy.yml).

# github_repository      = "your-name/private-llm-chat-cloudrun-gcp"
# github_terraform_apply = false   # true: CI may also run terraform apply (makes it a project Owner)
