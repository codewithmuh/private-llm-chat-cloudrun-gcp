# Where this web app's server finds Django, to pass /api/*, /admin/* and
# /django-static/* on to it (src/lib/backend-proxy.ts). Read at runtime.
#   http://localhost:8000   npm run dev against `make backend-dev` (the default)
#   http://api:8000         inside docker compose (set in docker-compose.yml)
#   https://api-...run.app  on Cloud Run (set by Terraform)
API_ORIGIN=http://localhost:8000
